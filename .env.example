# 复制为 .env 并填入真实值（.env 已被 git 忽略，不要提交）
PHONE=
PASSWORD=

# 宏云云端协议常量（从 APK 逆向提取的固定值，非用户凭据，一般无需改动；
# 代码已内置相同默认值，此处留空即可用默认）
HOMY_ACCESS_SECRET=99fdac79244d46cdb6968d264f4a9adf93b9f6de
# 登录协议使用的极光推送 registrationId（抓包占位值，固定）
HOMY_REG_ID=1507bfd3f69e38fde66

# 目标家庭：只配家庭名，familyUuid/clientId 由 bridge 启动时自动从 family/simple 解析
FAMILY_NAME=

# 本地 MQTT broker（桥接把云端状态转发到这里，HA 订阅这里）
# 九章上跑：填容器名 homy-mosquitto（同 compose 网络内直接解析）；本机调试：填九章公网 IP
LOCAL_MQTT_HOST=homy-mosquitto
LOCAL_MQTT_PORT=1883
# broker 认证账号（mosquitto 已开启密码认证；桥接与 HA 连 broker 用同一组账号密码）
MQTT_USER=admin
MQTT_PASS=123456

# 低频心跳间隔（秒）：定期拉一台设备保活 token + 兜底校准，默认 600（10 分钟）
TOKEN_HEARTBEAT_SECONDS=600

# 云端启动阶段（登录/查家庭/初始快照）失败后的原地重试间隔（秒），默认 300。
# 进程绝不因云端故障退出——否则 compose 秒级拉起 = 每秒一次请求，会把账号推进风控
CLOUD_RETRY_SECONDS=300
